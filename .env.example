# Machine-local paths for the dsh-forge test chain and maintenance scripts.
#
# Nothing here is needed by the plugin itself — only by the suites that talk to
# an installed DSH app plane, benchmark against a real corpus, or drive the
# local ripgrep. Copy this file to `.env` (gitignored) and fill in your paths.
#
# Real environment variables always win; `.env` only fills the gaps.

# Installed DSH `@deepseek-ai` package directory. Enables run-host-integration
# and the benchmark corpora. Example:
#   <DSH install>/resources/app/node_modules/@deepseek-ai
DSH_FORGE_DSH_MODULES=

# DSH application directory, for scripts/patch-workspace-changes.mjs.
# Example: <DSH install>/resources/app
DSH_APP_DIR=

# Source tree used by tests/bench.mjs and tests/bench-ast.mjs. Any large,
# stable, real repository works. Defaults to DSH_FORGE_DSH_MODULES when unset.
DSH_FORGE_BENCH_CORPUS=

# ripgrep binary used as the process-spawn baseline in tests/bench.mjs.
# Defaults to `rg` resolved through PATH.
DSH_FORGE_RG=

# Optional: an extra real repository for tests/eval-trace-real.mjs. Without it
# the suite looks for sibling checkouts and skips when it finds none.
DSH_FORGE_REAL_REPO=

# Optional: ProjectForge indexer binary and plugin directory. Both paths live
# OUTSIDE this repository, because VCPChat/ProjectForge is CC BY-NC-SA and must
# never ship with dsh-forge. When unset, the ProjectForge column of
# tests/eval-coverage.mjs degrades to "unavailable" instead of failing.
DSH_FORGE_PF_EXE=
DSH_FORGE_PF_PLUGIN=
